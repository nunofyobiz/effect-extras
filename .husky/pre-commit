set -e

# Regenerate API docs when source changes so committed docs/ never drift.
# docgen is a whole-project run (type-checks every @example via tsx), so only
# pay the cost when non-test source is staged. CI re-checks drift as a backstop.
if git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^src/.*\.ts$' | grep -qv '\.test\.ts$'; then
  pnpm docgen
  git add docs/
fi

# Avoid backup stashes: refs/stash is shared across worktrees.
unstaged_patch="$(git rev-parse --git-dir)/lint-staged_unstaged.patch"

print_recovery() {
  printf 'Unstaged changes are saved in %s. Restore them before retrying:\n' "$unstaged_patch" >&2
  printf 'git apply --whitespace=nowarn --recount --unidiff-zero "%s"\n' "$unstaged_patch" >&2
}

# Never overwrite a patch left by an interrupted run or a failed restoration.
if [ -f "$unstaged_patch" ]; then
  print_recovery
  exit 1
fi

if pnpm exec lint-staged --no-stash; then
  rm -f "$unstaged_patch"
else
  # lint-staged 17 skips restoring hidden hunks when a task fails without a backup.
  if [ -f "$unstaged_patch" ]; then
    if git apply --whitespace=nowarn --recount --unidiff-zero "$unstaged_patch"; then
      rm -f "$unstaged_patch"
    else
      print_recovery
    fi
  fi
  exit 1
fi
